{
  "name": "@repo/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./client": "./src/client/index.ts",
    "./schema": "./src/schema/index.ts",
    "./queries/users": "./src/queries/users/index.ts",
    "./queries/billing": "./src/queries/billing/index.ts",
    "./queries/example": "./src/queries/example/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "imports": {
    "#db/*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "auth:generate": "node scripts/auth-generate.mjs",
    "drizzle:generate": "drizzle-kit generate --config drizzle.config.ts",
    "drizzle:migrate": "drizzle-kit migrate --config drizzle.config.ts"
  },
  "dependencies": {
    "@repo/config": "workspace:*",
    "drizzle-orm": "catalog:",
    "postgres": "catalog:",
    "server-only": "catalog:"
  },
  "devDependencies": {
    "@better-auth/cli": "catalog:",
    "@repo/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:"
  }
}
