{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!pnpm-lock.yaml",
      "!**/.next",
      "!**/.next/**",
      "!**/.turbo",
      "!**/.turbo/**",
      "!**/coverage",
      "!**/coverage/**",
      "!**/dist",
      "!**/dist/**",
      "!**/out",
      "!**/out/**",
      "!**/.contentlayer",
      "!**/.contentlayer/**",
      "!**/.fumadocs",
      "!**/.fumadocs/**",
      "!**/drizzle/meta",
      "!**/drizzle/meta/**",
      "!**/drizzle/*.sql"
    ]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["@repo/*/src", "@repo/*/src/**"],
                "message": "Import workspace packages through their public package exports, not private src paths."
              },
              {
                "group": ["../../../**"],
                "message": "Use package exports or a closer module boundary instead of three-or-more-level relative imports."
              }
            ]
          }
        },
        "useImportType": "error"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  },
  "overrides": [
    {
      "includes": ["**/drizzle/*.sql"],
      "formatter": {
        "enabled": false
      },
      "linter": {
        "enabled": false
      },
      "assist": {
        "enabled": false
      }
    },
    {
      "includes": ["**/next-env.d.ts"],
      "formatter": {
        "enabled": false
      },
      "linter": {
        "enabled": false
      },
      "assist": {
        "enabled": false
      }
    }
  ]
}
