# Copy this file to .env.local for personal secrets and machine-specific overrides.
# Do not commit .env.local.

# Next.js sets NODE_ENV automatically. Override only for explicit local checks.
NODE_ENV=development

# Public browser-safe values.
NEXT_PUBLIC_APP_NAME=Flash Kit
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Core server configuration.
DATABASE_URL=postgres://flash_kit:flash_kit@localhost:54333/flash_kit
DATABASE_POOL_MAX=10
BETTER_AUTH_SECRET=

# OAuth providers are optional and configured server-side. When a provider is
# enabled, both credentials for that provider are required; the client secret
# must never be exposed as a NEXT_PUBLIC_* variable. Better Auth uses the
# provider callback routes /api/auth/callback/google and /api/auth/callback/github.
AUTH_GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_GITHUB_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Billing provider selection is mutually exclusive.
# Use BILLING_PROVIDER=stripe and set only the Stripe fields, or use
# BILLING_PROVIDER=polar and set only the Polar fields.
BILLING_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=

# Mailer provider selection is mutually exclusive.
# Use MAILER_PROVIDER=resend and set RESEND_API_KEY, or use MAILER_PROVIDER=smtp
# and set SMTP_HOST plus SMTP_PORT. SMTP_USER and SMTP_PASSWORD are optional for
# local Mailpit, but if either one is set then both are required.
MAILER_PROVIDER=smtp
EMAIL_FROM=noreply@example.com
RESEND_API_KEY=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
