{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    "biome.json",
    "package.json",
    "pnpm-workspace.yaml",
    "tooling/biome/*.json",
    "tooling/typescript/*.json",
    "turbo.json"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "CI",
        "NEXT_PUBLIC_APP_NAME",
        "NEXT_PUBLIC_SITE_URL",
        "DATABASE_URL",
        "DATABASE_POOL_MAX",
        "BETTER_AUTH_SECRET",
        "BILLING_PROVIDER",
        "STRIPE_SECRET_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "STRIPE_PRODUCT_PRO_MONTHLY",
        "STRIPE_PRICE_PRO_MONTHLY",
        "STRIPE_PRODUCT_PRO_YEARLY",
        "STRIPE_PRICE_PRO_YEARLY",
        "STRIPE_PRODUCT_LIFETIME",
        "STRIPE_PRICE_LIFETIME",
        "STRIPE_PRODUCT_CREDIT_PACK_100",
        "STRIPE_PRICE_CREDIT_PACK_100",
        "POLAR_ACCESS_TOKEN",
        "POLAR_WEBHOOK_SECRET",
        "POLAR_PRODUCT_PRO_MONTHLY",
        "POLAR_PRICE_PRO_MONTHLY",
        "POLAR_PRODUCT_PRO_YEARLY",
        "POLAR_PRICE_PRO_YEARLY",
        "POLAR_PRODUCT_LIFETIME",
        "POLAR_PRICE_LIFETIME",
        "POLAR_PRODUCT_CREDIT_PACK_100",
        "POLAR_PRICE_CREDIT_PACK_100",
        "MAILER_PROVIDER",
        "EMAIL_FROM",
        "RESEND_API_KEY",
        "SMTP_HOST",
        "SMTP_PORT",
        "SMTP_USER",
        "SMTP_PASSWORD",
        "AUTH_GOOGLE_ENABLED",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "AUTH_GITHUB_ENABLED",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET"
      ],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "start": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": ["*.tsbuildinfo", "**/*.tsbuildinfo", ".next/types/**"]
    },
    "lint": {
      "outputs": []
    },
    "format": {
      "cache": false
    },
    "format:check": {
      "outputs": []
    },
    "check": {
      "dependsOn": ["format:check", "lint", "typecheck", "build"],
      "outputs": []
    }
  }
}
