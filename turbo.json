{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    "biome.json",
    "package.json",
    "pnpm-workspace.yaml",
    "tooling/biome/*.json",
    "tooling/typescript/*.json",
    "turbo.json"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "start": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": ["*.tsbuildinfo", "**/*.tsbuildinfo", ".next/types/**"]
    },
    "lint": {
      "outputs": []
    },
    "format": {
      "cache": false
    },
    "format:check": {
      "outputs": []
    },
    "check": {
      "dependsOn": ["format:check", "lint", "typecheck", "build"],
      "outputs": []
    }
  }
}
